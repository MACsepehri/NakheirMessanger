generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            Int    @id @default(autoincrement())
  user_name     String @unique
  name_user     String
  user_password String

  createdAt DateTime @default(now())

  @@map("users")
}
